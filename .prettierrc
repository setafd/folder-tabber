{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "importOrder": [
    "^react$",
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)$",
    "^\\.\\./(?!.*\\.module\\.scss$)",
    "^\\./(?!.*\\.module\\.scss$)",
    ".*\\.module\\.scss$"
  ],
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "endOfLine": "auto",
  "arrowParens": "always"
}
